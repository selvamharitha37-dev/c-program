#include <stdio.h>

struct emp {
    int id;
    char name[20];
};

int main() {
    struct emp e[2]={{1,"Ravi"},{2,"Anita"}};
    int id;

    printf("Enter ID: ");
    scanf("%d",&id);

    for(int i=0;i<2;i++) {
        if(e[i].id==id) {
            printf("Name: %s\n", e[i].name);
            return 0;
        }
    }
    printf("Record not found\n");
    return 0;
}
