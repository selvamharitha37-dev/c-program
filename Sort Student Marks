#include <stdio.h>

int main() {
    int n, marks[50], temp;

    printf("Enter number of students: ");
    scanf("%d", &n);

    printf("Enter marks:\n");
    for (int i = 0; i < n; i++)
        scanf("%d", &marks[i]);

    for (int i = 0; i < n - 1; i++)
        for (int j = i + 1; j < n; j++)
            if (marks[i] > marks[j]) {
                temp = marks[i];
                marks[i] = marks[j];
                marks[j] = temp;
            }

    printf("Sorted marks:\n");
    for (int i = 0; i < n; i++)
        printf("%d ", marks[i]);

    return 0;
}
