#include <stdio.h>

int main() {
    float rain[7], total = 0;

    printf("Enter rainfall for 7 days:\n");
    for (int i = 0; i < 7; i++) {
        scanf("%f", &rain[i]);
        total += rain[i];
    }

    printf("Average rainfall = %.2f\n", total / 7);

    return 0;
}
