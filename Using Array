#include <stdio.h>

int main() {
    int n, marks[50];

    printf("Enter number of students: ");
    scanf("%d", &n);

    for (int i = 0; i < n; i++)
        scanf("%d", &marks[i]);

    printf("Marks:\n");
    for (int i = 0; i < n; i++)
        printf("%d ", marks[i]);

    return 0;
}
