#include <stdio.h>
#include <string.h>

int main() {
    char user[]="admin", pass[]="1234";
    char u[20], p[20];

    printf("Enter username: ");
    scanf("%s", u);
    printf("Enter password: ");
    scanf("%s", p);

    if(strcmp(u,user)==0 && strcmp(p,pass)==0)
        printf("Login successful\n");
    else
        printf("Invalid login\n");

    return 0;
}
