#include <stdio.h>

int main() {
    int minutes, hours, remainingMinutes;

    printf("Enter total minutes: ");
    scanf("%d", &minutes);

    hours = minutes / 60;
    remainingMinutes = minutes % 60;

    printf("Hours = %d, Minutes = %d\n", hours, remainingMinutes);
    return 0;
}
