#include <stdio.h>

int main() {
    int n, marks, total = 0;

    printf("Enter number of students: ");
    scanf("%d", &n);

    for (int i = 1; i <= n; i++) {
        printf("Enter marks of student %d: ", i);
        scanf("%d", &marks);
        total = total + marks;
    }

    printf("Total marks = %d\n", total);

    return 0;
}
