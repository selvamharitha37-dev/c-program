#include <stdio.h>

int main() {
    float rent, food, travel, total;

    printf("Enter rent, food and travel expenses: ");
    scanf("%f %f %f", &rent, &food, &travel);

    total = rent + food + travel;
    printf("Total monthly expenses = %.2f\n", total);

    return 0;
}
