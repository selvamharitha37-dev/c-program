#include <stdio.h>
#include <string.h>

int main() {
    char password[20];

    printf("Enter password: ");
    scanf("%s", password);

    if(strlen(password) >= 6)
        printf("Password is valid\n");
    else
        printf("Password is invalid\n");

    return 0;
}
