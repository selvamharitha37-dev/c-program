#include <stdio.h>

int main() {
    float price, quantity, total;

    printf("Enter price of item: ");
    scanf("%f", &price);

    printf("Enter quantity: ");
    scanf("%f", &quantity);

    total = price * quantity;

    printf("Total bill amount = %.2f\n", total);

    return 0;
}
