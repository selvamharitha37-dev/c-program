#include <stdio.h>

int main() {
    int n;
    float salary;

    printf("Enter number of employees: ");
    scanf("%d", &n);

    for(int i = 1; i <= n; i++) {
        printf("Enter salary of employee %d: ", i);
        scanf("%f", &salary);
        printf("Employee %d Salary = %.2f\n", i, salary);
    }

    return 0;
}
