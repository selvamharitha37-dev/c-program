#include <stdio.h>

float celsiusToFahrenheit(float c) {
    return (c * 9 / 5) + 32;
}

int main() {
    float c;
    printf("Enter temperature in Celsius: ");
    scanf("%f", &c);

    printf("Fahrenheit = %.2f\n", celsiusToFahrenheit(c));
    return 0;
}
