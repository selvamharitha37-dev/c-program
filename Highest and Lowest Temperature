#include <stdio.h>

int main() {
    int temp[7], max, min;

    printf("Enter temperatures for 7 days:\n");
    for (int i = 0; i < 7; i++)
        scanf("%d", &temp[i]);

    max = min = temp[0];

    for (int i = 1; i < 7; i++) {
        if (temp[i] > max) max = temp[i];
        if (temp[i] < min) min = temp[i];
    }

    printf("Highest temperature = %d\n", max);
    printf("Lowest temperature = %d\n", min);

    return 0;
}
