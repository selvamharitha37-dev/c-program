#include <stdio.h>

struct course {
    int code;
    char name[30];
    int duration;
};

int main() {
    struct course c;

    printf("Enter course code: ");
    scanf("%d", &c.code);
    printf("Enter course name: ");
    scanf("%s", c.name);
    printf("Enter duration (months): ");
    scanf("%d", &c.duration);

    printf("\nCourse Details\n");
    printf("Code: %d\nName: %s\nDuration: %d months\n",
           c.code, c.name, c.duration);

    return 0;
}
