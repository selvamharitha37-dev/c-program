#include <stdio.h>

int main() {
    int n, marks[50], max = 0, topper = 0;

    printf("Enter number of students: ");
    scanf("%d", &n);

    for(int i = 0; i < n; i++) {
        scanf("%d", &marks[i]);
        if(marks[i] > max) {
            max = marks[i];
            topper = i + 1;
        }
    }

    printf("Topper is student %d with marks %d\n", topper, max);
    return 0;
}
