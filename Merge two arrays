#include <stdio.h>

int main() {
    int a[5], b[5], c[10], i;

    printf("Enter 5 elements of first array:\n");
    for(i = 0; i < 5; i++)
        scanf("%d", &a[i]);

    printf("Enter 5 elements of second array:\n");
    for(i = 0; i < 5; i++)
        scanf("%d", &b[i]);

    for(i = 0; i < 5; i++) {
        c[i] = a[i];
        c[i + 5] = b[i];
    }

    printf("Merged array:\n");
    for(i = 0; i < 10; i++)
        printf("%d ", c[i]);

    return 0;
}
